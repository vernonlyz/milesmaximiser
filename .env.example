# Copy to .env.local and fill in your Supabase project values.
# Both are required; the app logs an error to the console if either is missing.
# The anon key is safe to expose in the client (public by design, gated by RLS).

# Project URL — Supabase dashboard → Project Settings → API → Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon / public key — Supabase dashboard → Project Settings → API → Project API keys → anon public
VITE_SUPABASE_ANON_KEY=your-anon-public-key
